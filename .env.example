# PostgreSQL connection string.
# Local development: use the credentials from your local Postgres.
DATABASE_URL="postgresql://eventroll:eventroll@localhost:5432/eventroll?schema=public"

# Secret used to sign the Auth.js JWT sessions.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Public base URL of the app (used in links and metadata).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
