generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GuestStatus {
  INVITED
  CHECKED_IN
  CANCELLED
}

enum EventStatus {
  ACTIVE
  CLOSED
}

enum AccessAction {
  CHECK_IN
  UNDO_CHECK_IN
}

enum StaffRole {
  GUARD
  COORDINATOR
  COOK
  MUSIC
  DECOR
  OTHER
}

enum ScheduleStatus {
  PENDING
  DONE
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  organization Organization?
}

model Organization {
  id        String     @id @default(cuid())
  name      String
  ownerId   String     @unique
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  events    Event[]
  guests    Guest[]
  staff     Staff[]
  logs      AccessLog[]
  tables    EventTable[]
  chairs    Chair[]
  schedule  ScheduleItem[]
}

model Event {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  date           DateTime
  location       String
  description    String?
  status         EventStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  guests         Guest[]
  staff          Staff[]
  logs           AccessLog[]
  tables         EventTable[]
  chairs         Chair[]
  schedule       ScheduleItem[]

  @@index([organizationId, date])
}

model Guest {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code           String      @unique
  name           String
  searchName     String
  email          String?
  phone          String?
  category       String?
  plusOnes       Int         @default(0)
  table          String?
  notes          String?
  status         GuestStatus @default(INVITED)
  checkedInAt    DateTime?
  checkedInById  String?
  checkedInBy    Staff?      @relation("StaffCheckIns", fields: [checkedInById], references: [id], onDelete: SetNull)
  logs           AccessLog[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([eventId, name])
  @@index([eventId, searchName])
  @@index([eventId, status])
  @@index([eventId, email])
}

model Staff {
  id               String    @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId          String
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code             String    @unique
  name             String
  role             StaffRole @default(GUARD)
  canCheckIn       Boolean   @default(true)
  active           Boolean   @default(true)
  canViewContact   Boolean   @default(false)
  canEditGuests    Boolean   @default(false)
  canExport        Boolean   @default(false)
  canUndoCheckIn   Boolean   @default(false)
  canViewStats     Boolean   @default(false)
  lastLoginAt      DateTime?
  sessionVersion   Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  checkIns         Guest[]   @relation("StaffCheckIns")
  logs             AccessLog[]
  scheduleItems    ScheduleItem[]

  @@index([eventId, active])
  @@index([organizationId])
}

model AccessLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId        String?
  guest          Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestName      String
  staffId        String?
  staff          Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  action         AccessAction
  createdAt      DateTime     @default(now())

  @@index([eventId, createdAt])
  @@index([staffId, createdAt])
}

model EventTable {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  capacity       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  chairs         Chair[]

  @@unique([eventId, name])
  @@index([eventId])
}

model Chair {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableId        String
  table          EventTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  number         Int
  occupied       Boolean      @default(false)
  guestName      String?
  updatedAt      DateTime     @updatedAt

  @@unique([tableId, number])
  @@index([eventId])
}

model ScheduleItem {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime?
  status         ScheduleStatus @default(PENDING)
  assigneeId     String?
  assignee       Staff?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([eventId, startAt])
  @@index([assigneeId])
}
